---
const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#education', label: 'Education' },
];
---
<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-gray-950/70 border-b border-gray-800/50">
  <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#" class="text-lg font-semibold text-white hover:text-primary transition-colors">
      HQP
    </a>
    <div class="hidden sm:flex items-center gap-8">
      {links.map(({ href, label }) => (
        <a
          href={href}
          data-nav-link
          class="nav-link text-sm text-gray-400 hover:text-white transition-colors"
        >
          {label}
        </a>
      ))}
      <a
        href="/assets/resume.pdf"
        target="_blank"
        class="text-sm px-4 py-2 rounded-full border border-primary/50 text-primary hover:bg-primary/10 transition-all"
      >
        Resume
      </a>
    </div>
    <!-- Mobile menu button -->
    <button id="menu-toggle" class="sm:hidden text-gray-400 hover:text-white">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden sm:hidden px-6 pb-4 space-y-3">
    {links.map(({ href, label }) => (
      <a
        href={href}
        class="block text-sm text-gray-400 hover:text-white transition-colors"
      >
        {label}
      </a>
    ))}
    <a
      href="/assets/resume.pdf"
      target="_blank"
      class="block text-sm text-primary"
    >
      Resume
    </a>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
  // Close mobile menu on link click
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => menu?.classList.add('hidden'));
  });

  // Mark the nav link for whichever section is currently in view.
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const byId = new Map(navLinks.map((a) => [a.getAttribute('href')?.slice(1), a]));
  const sections = [...byId.keys()]
    .map((id) => id && document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  const spy = new IntersectionObserver(
    (entries) => {
      entries
        .filter((e) => e.isIntersecting)
        .forEach((e) => {
          navLinks.forEach((a) => a.classList.remove('nav-link-active'));
          byId.get(e.target.id)?.classList.add('nav-link-active');
        });
    },
    // Trip when a section crosses the upper third, so the highlight
    // changes as that section takes over the viewport.
    { rootMargin: '-30% 0px -60% 0px' }
  );

  sections.forEach((el) => spy.observe(el));
</script>
