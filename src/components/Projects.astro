---
import { isOrphan, CENTER_ORPHAN } from '../lib/card-grid';
import { projects, PROJECT_GROUPS } from '../data/content';

// Grouped so the three competencies read as distinct, rather than as one AI
// card sitting alongside three chemistry cards.
const grouped = PROJECT_GROUPS
  .map((group) => ({ group, items: projects.filter((p) => p.group === group) }))
  .filter(({ items }) => items.length > 0);
---
<section id="projects" class="relative z-10 py-24 px-6">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-white mb-12 reveal">
      <span class="text-primary">//</span> Projects
    </h2>
    {grouped.map(({ group, items }) => (
    <div class="mb-12 last:mb-0">
      <h3 class="text-xs font-mono uppercase tracking-widest text-primary/70 mb-4 reveal">{group}</h3>
      <div class="grid md:grid-cols-2 gap-6 stagger-children">
      {items.map((project, i) => (
        <div
          style={`--i: ${i}`}
          class:list={[
            'glow-card p-6 group flex flex-col',
            isOrphan(i, items.length) && CENTER_ORPHAN,
          ]}
        >
          <div class="flex items-start justify-between gap-4 mb-3">
            <div>
              <h3 class="text-xl font-semibold text-white group-hover:text-primary transition-colors">
                {project.title}
              </h3>
              <p class="text-sm text-primary/70 font-mono mt-1">{project.tagline}</p>
            </div>
            {project.links.length > 0 && (
              <div class="flex flex-wrap justify-end gap-2 shrink-0">
                {project.links.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    class="text-xs px-3 py-1 rounded-full border border-gray-700 text-gray-400 hover:border-primary hover:text-primary transition-all"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">{project.description}</p>
          <div class="flex flex-wrap gap-2 mt-auto">
            {project.tags.map((tag) => (
              <span class="text-xs px-2.5 py-1 rounded-full bg-primary/10 text-primary/80">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
      </div>
    </div>
    ))}
  </div>
</section>
