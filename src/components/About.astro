---
import { about } from '../data/content';
---
<section id="about" class="relative z-10 py-24 px-6">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-white mb-12 reveal">
      <span class="text-primary">//</span> About Me
    </h2>
    <div class="glow-card p-8 md:p-10 reveal">
      <p class="text-lg text-gray-300 leading-relaxed mb-6 italic">
        {about.standfirst}
      </p>
      {about.paragraphs.map((paragraph) => (
        <p class="text-gray-400 leading-relaxed mb-6 last:mb-0">{paragraph}</p>
      ))}
    </div>
  </div>
</section>
