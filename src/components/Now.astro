---
/**
 * What he is doing now, assembled from data rather than written prose so it
 * cannot go stale: the current appointment comes from the experience list, the
 * latest output from the publication list, the counts from the software list.
 *
 * This exists because the rest of the page is a record of the past. The AI
 * work in particular was only visible at the very bottom, which left "AI +
 * Science is the current focus" as an assertion above the fold.
 */
import { experiences, software } from '../data/content';
import { publications, publicationUrl } from '../lib/publications';

const current = experiences[0];
const latest = publications.slice(0, 3);
const ledCount = software.filter((pkg) => pkg.role === 'Lead developer').length;
const contributedCount = software.filter((pkg) => pkg.role === 'Contributor').length;
---
<section id="now" class="relative z-10 pt-8 pb-16 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="glow-card p-8 md:p-10 reveal">
      <div class="grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-8 md:gap-12">
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-primary/70 mb-4">
            Currently
          </p>
          <p class="text-lg text-gray-200 leading-relaxed">
            {current.role} at <span class="text-white font-medium">{current.title}</span>,
            working on {current.focus}.
          </p>
          <p class="text-sm text-gray-500 mt-3 font-mono">{current.period}</p>
          <p class="text-sm text-gray-400 mt-6 leading-relaxed">
            Lead developer on {ledCount} scientific packages, contributor to {contributedCount} more.
          </p>
        </div>

        <div class="md:border-l md:border-gray-800 md:pl-12">
          <p class="text-xs font-mono uppercase tracking-widest text-primary/70 mb-4">
            Latest work
          </p>
          <ul class="space-y-3">
            {latest.map((pub) => (
              <li class="flex gap-3">
                <span class="text-xs font-mono text-primary/60 pt-1 shrink-0 tabular-nums">
                  {pub.year}
                </span>
                {publicationUrl(pub) ? (
                  <a
                    href={publicationUrl(pub)}
                    target="_blank"
                    rel="noopener"
                    class="text-sm text-gray-300 hover:text-primary transition-colors leading-snug"
                  >
                    {pub.title}
                  </a>
                ) : (
                  <span class="text-sm text-gray-300 leading-snug">{pub.title}</span>
                )}
              </li>
            ))}
          </ul>
          <a
            href="#publications"
            class="inline-block mt-5 text-xs font-mono uppercase tracking-wide text-gray-500 hover:text-primary transition-colors"
          >
            All {publications.length} publications →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
