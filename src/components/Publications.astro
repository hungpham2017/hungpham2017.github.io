---
import {
  publications,
  preprintCount,
  publicationUrl,
  ORCID_URL,
  SCHOLAR_URL,
  ARXIV_URL,
} from '../lib/publications';
---
<section id="publications" class="relative z-10 py-24 px-6">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-white mb-4 reveal">
      <span class="text-primary">//</span> Publications
    </h2>

    <p class="mb-10 text-sm text-gray-500 reveal">
      {`${publications.length} works including ${preprintCount} preprint${preprintCount === 1 ? '' : 's'}`}, from
      <a href={ORCID_URL} target="_blank" rel="noopener" class="text-primary/80 hover:text-primary transition-colors">ORCID</a>
      and <a href={ARXIV_URL} target="_blank" rel="noopener" class="text-primary/80 hover:text-primary transition-colors">arXiv</a>. Full record on
      <a href={SCHOLAR_URL} target="_blank" rel="noopener" class="text-primary/80 hover:text-primary transition-colors">Google Scholar</a>.
    </p>

    <div class="glow-card divide-y divide-gray-800/70 reveal">
      {publications.map((pub) => (
        <article class="flex gap-5 px-6 py-4 group">
          <span class="text-sm font-mono text-primary/60 pt-0.5 w-12 shrink-0 tabular-nums">
            {pub.year ?? '—'}
          </span>
          <div class="min-w-0">
            {publicationUrl(pub) ? (
              <a
                href={publicationUrl(pub)}
                target="_blank"
                rel="noopener"
                class="text-gray-200 group-hover:text-primary transition-colors"
              >
                {pub.title}
              </a>
            ) : (
              <span class="text-gray-200">{pub.title}</span>
            )}
            <p class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1">
              {pub.journal && <span class="text-sm text-gray-500 italic">{pub.journal}</span>}
              {!pub.doi && pub.arxivId && (
                <>
                  <span class="text-[11px] uppercase tracking-wide px-2 py-0.5 rounded-full bg-primary/10 text-primary/80">Preprint</span>
                  <span class="text-sm font-mono text-gray-600">arXiv:{pub.arxivId}</span>
                </>
              )}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
