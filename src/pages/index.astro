---
import Layout from '../layouts/Layout.astro';
/**
 * The sky design. A night sky of twinkling stars, some of them small
 * molecules (neurotransmitters) drawn as star clusters. A shining star travels
 * between four of them in a never-ending loop (serotonin, dopamine,
 * adrenaline, melatonin) and each one it reaches is generated from noise to
 * full structure, then folds back into its cluster.
 *
 * All content comes from src/data/content.ts and src/data/publications.json.
 * The previous designs are archived at /previous and /classic.
 */
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
import { publications, publicationUrl, SCHOLAR_URL, type Publication } from '../lib/publications';
import {
  software, experiences, education, identity, about, links,
  heroLine, scholarStats, workAreas,
} from '../data/content';

const norm = (t: string | null) => (t ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
const pubsFor = (prefixes: string[]) =>
  publications.filter((p) => prefixes.some((pre) => norm(p.title).startsWith(norm(pre))));

// Recent papers: at least five, and always every paper from the latest year.
const latest = Math.max(...publications.map((p) => p.year ?? 0));
const shown = Math.max(5, publications.filter((p) => p.year === latest).length);
const recent = publications.slice(0, shown);
const older = publications.slice(shown);
const venue = (p: Publication) => p.journal ?? (p.arxivId ? `arXiv:${p.arxivId}` : 'Preprint');

const roleLabel = (r: string) => r;

// "March 2022 — Present" -> "2022–now"
const shortPeriod = (period: string) => {
  const years = period.match(/\d{4}/g) ?? [];
  const end = /present/i.test(period) ? 'now' : years[1] ?? '';
  return end ? `${years[0]}–${end}` : years[0] ?? '';
};
const resume = '/assets/resume.pdf';
---
<Layout title={`${identity.name} — AI × Quantum, for chemistry and beyond`}
  description="Hung Q. Pham — research scientist working at AI × quantum chemistry: generative models for chemistry, quantum many-body methods and GPU-accelerated simulation, plus AI products.">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Figtree:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" />
  </Fragment>

<header class="hero">
  <canvas id="cloud" aria-label="A night sky where some stars are small molecules; a shining star travels between them and each one it reaches is generated in full."></canvas>
  <div class="hero-in gutter">
    <div class="bar">
      <span class="mark">hungqpham.com</span>
      <nav><a href="#work">Work</a><a href="#software">Software</a><a href="#papers">Papers</a><a href="#experience">CV</a><a href="#contact">Contact</a></nav>
    </div>
    <div class="hero-main" id="about">
    <div class="title">
      <div class="headshot"><Image src={photo} alt={identity.name} width={360} format="webp" quality={82} /></div>
      <h1>{identity.name.replace(' Pham', ' Pham')}</h1>
      <p><b>{heroLine.a}</b> × <i>{heroLine.b}</i>{heroLine.rest}</p>
    </div>
    <div class="hero-about">
      {about.paragraphs.map((p) => <p set:html={p} />)}
    </div>
    </div>
    <div class="spec"><div class="readout" id="readout" hidden></div></div>
  </div>
</header>

<main class="gutter">
  <section class="sec" id="work">
    <h2><small>Work</small>What I work on</h2>
    <div>
      <div class="threads">
        {workAreas.map((w) => {
          const list = pubsFor(w.papers);
          return (
            <article class="thread">
              <canvas class="art" data-art={w.title} aria-hidden="true"></canvas>
              <span class="k">{w.kind}</span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
              {list.length > 0 && (
                <details class="cp">
                  <summary>Papers ({list.length})</summary>
                  <ul>{list.map((p) => (
                    <li><span class="cy">{p.year}</span><span>
                      {publicationUrl(p) ? <a href={publicationUrl(p)} target="_blank" rel="noopener">{p.title}</a> : <span class="nl">{p.title}</span>}
                      <span class="cv">{venue(p)}</span></span></li>
                  ))}</ul>
                </details>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="sec" id="software">
    <h2><small>Software</small>Things I've built and shipped</h2>
    <ul class="list">
      {software.map((pkg) => (
        <li>
          <span class="n">{(pkg.url ?? pkg.paper) ? <a href={pkg.url ?? pkg.paper} target="_blank" rel="noopener">{pkg.name}</a> : pkg.name}</span>
          <span class="r">{roleLabel(pkg.role)}</span>
          <span class="d">{pkg.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec" id="papers">
    <h2><small>Papers</small>Recent papers</h2>
    <div>
      <ul class="pubs">
        {recent.map((p) => (
          <li><span class="y">{p.year}</span><span>
            {publicationUrl(p) ? <a href={publicationUrl(p)} target="_blank" rel="noopener">{p.title}</a> : <span class="nl">{p.title}</span>}
            <span class="j">{venue(p)}</span></span></li>
        ))}
      </ul>
      <details class="all">
        <summary><span class="o">Show {older.length} more ({publications.length} in total)</span><span class="c">Show fewer</span></summary>
        <ul class="pubs">
          {older.map((p) => (
            <li><span class="y">{p.year}</span><span>
              {publicationUrl(p) ? <a href={publicationUrl(p)} target="_blank" rel="noopener">{p.title}</a> : <span class="nl">{p.title}</span>}
              <span class="j">{venue(p)}</span></span></li>
          ))}
        </ul>
      </details>
      <a class="more" href={SCHOLAR_URL} target="_blank" rel="noopener">Google Scholar</a>
    </div>
  </section>

  <section class="sec" id="experience">
    <h2><small>Experience</small>Academia and industry</h2>
    <div class="path">
      {experiences.map((e) => (
        <div><span class="t">{shortPeriod(e.period)}</span><span><b>{e.title}</b>
          <span>{e.role}{e.advisor && ` with ${e.advisor}`}</span>
          {e.focus && <span class="f">{e.focus}</span>}</span></div>
      ))}
    </div>
  </section>

  <section class="sec" id="education">
    <h2><small>Education</small>Academic background</h2>
    <div class="path">
      {education.map((e) => (
        <div><span class="t">{shortPeriod(e.period)}</span><span><b>{e.degree}</b><span>{e.school}</span></span></div>
      ))}
      <a class="more" href={resume} target="_blank" rel="noopener">Full CV (PDF)</a>
    </div>
  </section>

  <section class="contact" id="contact">
    <h2>Working on something useful?</h2>
    <p class="cta-sub">I'd like to bring an AI + Science mindset to it.</p>
    <div class="addr">{links.email.replace('mailto:', '')}</div>
    <div class="links">
      <a href={links.github} target="_blank" rel="noopener">GitHub</a>
      <a href={links.scholar} target="_blank" rel="noopener">Google Scholar</a>
      <a href={links.orcid} target="_blank" rel="noopener">ORCID</a>
      <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={links.twitter} target="_blank" rel="noopener">X / Twitter</a>
      <a href={resume} target="_blank" rel="noopener">CV (PDF)</a>
    </div>
    <p class="colophon">© {new Date().getFullYear()} {identity.name}</p>
  </section>
</main>

<script is:inline>

(function(){
  var css = getComputedStyle(document.documentElement);
  function tok(n){ return css.getPropertyValue(n).trim(); }
  var BG = tok("--bg"), INK = tok("--ink"), MUTED = tok("--muted"), WARM = tok("--warm"), COOL = tok("--cool");
  var EL = { C: INK, N: COOL, O: WARM };
  // On a bright page a star field reads as specks of dirt, so the sky is drawn as a
  // sketch instead: no galaxy band, a sparse scatter of soft violet and blue points,
  // and molecules in thin blue lines. LIGHT is detected from the page colour.
  var LIGHT = (function(h){ h=h.replace("#",""); if(h.length===3) h=h.replace(/./g,"$&$&"); var n=parseInt(h,16); return ((n>>16&255)*.3+(n>>8&255)*.59+(n&255)*.11) > 140; })(BG);
  var SKETCH = LIGHT ? COOL : INK;

  // ---- bright mode: noise -> electron cloud (AI x Quantum in one image) ----
  // Thousands of fine dots start as a shapeless Gaussian cloud (the generative model's
  // noise), flow along smooth curved trajectories (its sampling path) and settle into the
  // electron density of a molecule (the quantum part): dense at the nuclei, a haze along
  // the bonds, wispy at the edges. It breathes, then dissolves back into noise and the
  // next molecule forms. Dots take the colour of the atom they belong to.
  // The haze fills the whole banner; one cloud tours the open sky, condensing into a
  // molecule at each stop and drifting on as noise to the next.
  var GLOW0 = (function(h){ h=h.replace("#",""); if(h.length===3) h=h.replace(/./g,"$&$&"); var n=parseInt(h,16); return "rgba("+(n>>16&255)+","+(n>>8&255)+","+(n&255)+",0)"; })(WARM);
  var TOUR_MOLS = [0, 1, 4, 2], TXT_TOP = 0, dens = null, CARBON = "#52627a";   // carbon in soft blue-slate, not ink          // serotonin, dopamine, epinephrine, melatonin
  function buildDensity(){
    var r = rng(5), x0 = wide ? X0 : 0;
    TXT_TOP = document.querySelector(".hero .title h1").getBoundingClientRect().top - cv.getBoundingClientRect().top - 8;
    // one cloud on a tour, like the old explorer: each molecule forms at the next spot
    // (fractions of the open sky), and the noise drifts there between molecules
    var y0 = wide ? 40 : B0, rw = W - x0, rh = (wide ? B1 : B1) - y0;
    var bw = wide ? rw*0.42 : rw*0.8, bh = wide ? rh*0.6 : rh*0.85, spots;
    if(wide){
      // on a wide screen the tour stays near the headshot: a row of stops just right of
      // the portrait, in the open band above the name and beside the tagline
      var cr = cv.getBoundingClientRect(), hs = document.querySelector(".hero .headshot").getBoundingClientRect();
      var hx = hs.right - cr.left, hy = (hs.top + hs.bottom)/2 - cr.top;
      bw = Math.min(320, W*0.24); bh = Math.min(170, (hs.bottom - cr.top)*0.95);
      spots = [[hx + 40 + bw*0.5, hy], [hx + 40 + bw*1.45, hy - 8], [hx + 40 + bw*0.95, hy + 6], [hx + 40 + bw*1.9, hy + 4]];
    } else {
      spots = [[0.5,0.45],[0.3,0.55],[0.7,0.5],[0.5,0.6]].map(function(f){ return [x0 + f[0]*rw, y0 + f[1]*rh]; });
    }
    spots = spots.map(function(p){ return [Math.max(bw*0.5 + 8, Math.min(W - bw*0.55 - 12, p[0])), Math.max(bh*0.5 + 8, p[1])]; });   // keep every stop fully on screen
    var slots = [[spots[0][0], spots[0][1], bw, bh, wide ? 4600 : 2400, 0.0, 0]];
    function dot(){ return { nx: gauss(r), ny: gauss(r), u1: r(), u2: r(), u3: r(), g1: gauss(r), g2: gauss(r), bend: gauss(r)*0.35, ph: r()*6.28, a: 0.45 + r()*0.55, tint: r() < 0.5 ? COOL : WARM, lag: Math.pow(r(), 1.6) }; }
    dens = { slots: slots.map(function(sl){ var P = []; for(var i=0;i<sl[4];i++) P.push(dot());
               return { cx: sl[0], cy: sl[1], w: sl[2], h: sl[3], off: sl[5], first: sl[6], P: P, cyc: -1, T: null, spots: spots, from: spots[0] }; }),
             haze: [] };
    for(var i=0;i<(wide?1500:700);i++) dens.haze.push({ x: r()*W, y: r()*H, ph: r()*6.28, a: 0.08 + r()*0.16, sp: 0.4 + r()*0.8 });
  }
  function densityTargets(sl, m){
    // fit the molecule into its slot, then give every dot a place in its electron cloud
    var xs = m.P.map(function(p){ return p[0]; }), ys = m.P.map(function(p){ return p[1]; });
    var mx = (Math.min.apply(0,xs)+Math.max.apply(0,xs))/2, my = (Math.min.apply(0,ys)+Math.max.apply(0,ys))/2;
    var sc = Math.min(sl.w*0.8/(Math.max.apply(0,xs)-Math.min.apply(0,xs)+1.2), sl.h*0.9/(Math.max.apply(0,ys)-Math.min.apply(0,ys)+1.2));
    var heavy = { C: 6, N: 7, O: 8 }, wsum = 0, comps = [];
    m.atoms.forEach(function(a,k){ var wgt = heavy[a[0]] || 6; comps.push({ k: k, w: wgt }); wsum += wgt; });
    sl.geom = { A: m.P.map(function(q){ return [sl.cx + (q[0]-mx)*sc, sl.cy + (q[1]-my)*sc]; }), el: m.atoms.map(function(a){ return a[0]; }), bonds: m.bonds, sc: sc };
    return sl.P.map(function(p){
      var X, Y, el, ax, ay;
      if(p.u1 < 0.55){                                 // around a nucleus, weighted by its electrons
        var pick = p.u2*wsum, c = comps[0]; for(var q=0;q<comps.length;q++){ pick -= comps[q].w; if(pick <= 0){ c = comps[q]; break; } }
        var s = p.u3 < 0.88 ? 0.14 : 0.36;             // a tight core and a thin halo
        ax = m.P[c.k][0]; ay = m.P[c.k][1]; X = ax + p.g1*s; Y = ay + p.g2*s; el = m.atoms[c.k][0];
      } else {                                         // shared along a bond
        var b = m.bonds[Math.floor(p.u2*m.bonds.length)], A = m.P[b[0]], B = m.P[b[1]], f = p.u3;
        ax = A[0] + (B[0]-A[0])*f; ay = A[1] + (B[1]-A[1])*f; X = ax + p.g1*0.07; Y = ay + p.g2*0.07; el = f < 0.5 ? m.atoms[b[0]][0] : m.atoms[b[1]][0];
      }
      return [sl.cx + (X-mx)*sc, sl.cy + (Y-my)*sc, el === "N" ? COOL : el === "O" ? WARM : CARBON, sl.cx + (ax-mx)*sc, sl.cy + (ay-my)*sc];
    });
  }
  // the resolved molecule: fine bonds and small atoms, in the page's slate, cyan and indigo
  function drawSkeleton(sl, k, breathe){
    var G = sl.geom, P = G.A.map(function(a){ return [sl.cx + (a[0]-sl.cx)*breathe, sl.cy + (a[1]-sl.cy)*breathe]; });
    var rC = Math.max(2.2, Math.min(3.6, G.sc*0.075)), off = Math.max(1.4, G.sc*0.05);
    ctx.lineCap = "round"; ctx.strokeStyle = "#334155"; ctx.lineWidth = 1.1; ctx.globalAlpha = 0.85*k;
    G.bonds.forEach(function(b){ var p = P[b[0]], q = P[b[1]], dx = q[0]-p[0], dy = q[1]-p[1], L = Math.hypot(dx,dy)||1, nx = -dy/L*off, ny = dx/L*off;
      ctx.beginPath();
      if(b[2]===2){ ctx.moveTo(p[0]+nx,p[1]+ny); ctx.lineTo(q[0]+nx,q[1]+ny); ctx.moveTo(p[0]-nx,p[1]-ny); ctx.lineTo(q[0]-nx,q[1]-ny); }
      else { ctx.moveTo(p[0],p[1]); ctx.lineTo(q[0],q[1]); }
      ctx.stroke(); });
    P.forEach(function(q,j){ var el = G.el[j], r = el === "C" ? rC : rC*1.3;
      ctx.globalAlpha = k; ctx.fillStyle = BG; ctx.beginPath(); ctx.arc(q[0], q[1], r + 1.4, 0, 6.283); ctx.fill();
      ctx.fillStyle = el === "N" ? COOL : el === "O" ? WARM : "#334155"; ctx.beginPath(); ctx.arc(q[0], q[1], r, 0, 6.283); ctx.fill(); });
  }
  function quiet(x, y){ return wide ? (x < X0 - 30 && y > TXT_TOP && y < B1 ? 0.22 : 1) : (y > B1 && y < H*0.8 ? 0.3 : 1); }   // hush behind the name and text
  function drawDensity(now){
    if(!dens) return;
    var t = now*0.001;
    // the ambient haze: noise that is always there, drifting slowly
    ctx.fillStyle = MUTED;
    dens.haze.forEach(function(h){ var x = h.x + Math.sin(t*0.2*h.sp + h.ph)*14, y = h.y + Math.cos(t*0.17*h.sp + h.ph)*10;
      ctx.globalAlpha = h.a*quiet(x,y); ctx.fillRect(x, y, 1, 1); });
    dens.slots.forEach(function(sl){
      var D = 11000, ph = now/D + sl.off, c = Math.floor(ph), v = ph - c;
      if(reduce){ c = 0; v = 0.7; }
      if(c !== sl.cyc){ var n = sl.spots.length, prev = sl.spots[((c-1) % n + n) % n], cur = sl.spots[c % n];
        sl.cyc = c; sl.from = prev; sl.cx = cur[0]; sl.cy = cur[1];
        sl.T = densityTargets(sl, MOLS[TOUR_MOLS[(c + sl.first) % TOUR_MOLS.length]]); }
      // travel (noise drifts to the new spot) -> flow -> hold (breathing) -> dissolve back to noise
      var e = v < .22 ? 0 : v < .52 ? ease((v-.22)/.3) : v < .9 ? 1 : 1 - ease((v-.9)/.1);
      var k = v < .52 ? 0 : v < .62 ? ease((v-.52)/.1) : v < .83 ? 1 : v < .9 ? 1 - ease((v-.83)/.07) : 0;   // the real molecule
      if(reduce){ e = 1; k = 1; }
      var go = reduce ? 1 : ease(Math.min(1, v/.22)), hx = sl.from[0] + (sl.cx - sl.from[0])*go, hy = sl.from[1] + (sl.cy - sl.from[1])*go;
      var tdx = sl.cx - sl.from[0], tdy = sl.cy - sl.from[1], trail = reduce ? 0 : 0.7*Math.sin(Math.PI*Math.min(1, v/.22));
      var R = Math.min(sl.w, sl.h)*0.3, breathe = 1 + 0.025*Math.sin(t*1.3 + sl.off*6);
      var ncx = hx + Math.sin(t*0.3 + sl.off*5)*R*0.1, ncy = hy + Math.cos(t*0.25 + sl.off*5)*R*0.08, ct = Math.cos(t*0.12), st = Math.sin(t*0.12);
      if(e > 0.05){   // a faint indigo glow where the molecule is forming
        var gr = Math.max(sl.w, sl.h)*0.55, g = ctx.createRadialGradient(sl.cx, sl.cy, 0, sl.cx, sl.cy, gr);
        g.addColorStop(0, WARM); g.addColorStop(1, GLOW0);   // fade to transparent indigo, not to black
        ctx.globalAlpha = 0.07*e; ctx.fillStyle = g; ctx.fillRect(sl.cx-gr, sl.cy-gr, gr*2, gr*2); }
      var last = null;
      for(var i=0;i<sl.P.length;i++){
        var p = sl.P[i], T = sl.T[i];
        var nx = ncx + (p.nx*ct - p.ny*st)*R - trail*p.lag*tdx, ny = ncy + (p.nx*st + p.ny*ct)*R*0.7 - trail*p.lag*tdy;   // streams behind while it travels
        var tight = 1 - 0.55*k, bx = T[3] + (T[0]-T[3])*tight, by = T[4] + (T[1]-T[4])*tight;   // the cloud draws in around the skeleton
        var tx = sl.cx + (bx-sl.cx)*breathe, ty = sl.cy + (by-sl.cy)*breathe;
        var dx = tx-nx, dy = ty-ny, arc = Math.sin(Math.PI*e)*p.bend;          // a gentle curve, not a straight line
        var x = nx + dx*e - dy*arc, y = ny + dy*e + dx*arc;
        x += Math.sin(t*1.7 + p.ph)*(0.35 + 1.8*(1-e)); y += Math.cos(t*1.5 + p.ph*1.3)*(0.35 + 1.8*(1-e));   // walkers never sit still
        var col = e > 0.5 ? T[2] : p.tint;
        if(col !== last){ ctx.fillStyle = col; last = col; }
        ctx.globalAlpha = p.a*(e > 0.5 ? (0.3 + 0.32*e)*(1 - 0.45*k) : 0.4)*(e > 0.5 ? 1 : quiet(x,y));
        ctx.fillRect(x, y, 0.9, 0.9);
      }
      if(k > 0.01) drawSkeleton(sl, k, breathe);
    });
  }
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var ro = document.getElementById("readout"); if(ro) ro.hidden = true;
  function rng(seed){ return function(){ seed|=0; seed=seed+0x6D2B79F5|0; var t=Math.imul(seed^seed>>>15,1|seed); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }
  function gauss(r){ var u=1-r(), v=r(); return Math.sqrt(-2*Math.log(u))*Math.cos(6.2832*v); }
  function ease(a){ return a<.5 ? 4*a*a*a : 1-Math.pow(-2*a+2,3)/2; }

  /* Real molecules, heavy atoms only, unit bond length: [element, x, y] and [i, j, order]. */
  var MOLS = [
    { atoms:[["C",0,1],["C",.866,.5],["C",.866,-.5],["C",0,-1],["C",-.866,-.5],["C",-.866,.5],["C",1.817,.809],["C",2.405,0],["N",1.817,-.809],["O",-1.732,1],["C",2.126,1.76],["C",3.104,1.968],["N",3.413,2.919]],
      bonds:[[5,0,2],[0,1,1],[1,2,2],[2,3,1],[3,4,2],[4,5,1],[1,6,1],[6,7,2],[7,8,1],[8,2,1],[5,9,1],[6,10,1],[10,11,1],[11,12,1]] },                         // serotonin
    { atoms:[["C",0,1],["C",.866,.5],["C",.866,-.5],["C",0,-1],["C",-.866,-.5],["C",-.866,.5],["C",1.732,1],["C",2.598,.5],["N",3.464,1],["O",-1.732,1],["O",-1.732,-1]],
      bonds:[[0,1,2],[1,2,1],[2,3,2],[3,4,1],[4,5,2],[5,0,1],[1,6,1],[6,7,1],[7,8,1],[5,9,1],[4,10,1]] },                                                     // dopamine
    { atoms:[["C",0,1],["C",.866,.5],["C",.866,-.5],["C",0,-1],["C",-.866,-.5],["C",-.866,.5],["C",1.817,.809],["C",2.405,0],["N",1.817,-.809],["O",-1.732,1],["C",2.126,1.76],["C",3.104,1.968],["N",3.413,2.919],["C",-2.598,1.5],["C",4.391,3.127],["O",4.7,4.078],["C",5.06,2.384]],
      bonds:[[5,0,2],[0,1,1],[1,2,2],[2,3,1],[3,4,2],[4,5,1],[1,6,1],[6,7,2],[7,8,1],[8,2,1],[5,9,1],[6,10,1],[10,11,1],[11,12,1],[9,13,1],[12,14,1],[14,15,2],[14,16,1]] },   // melatonin
    { atoms:[["C",0,1],["C",.866,.5],["C",.866,-.5],["C",0,-1],["C",-.866,-.5],["C",-.866,.5],["C",1.732,1],["C",2.598,.5],["N",3.464,1],["O",-1.732,1],["O",-1.732,-1],["O",1.732,2]],
