---
import Layout from '../layouts/Layout.astro';
/**
 * Concept: two records, one practice. Software and Publications are typeset in
 * an identical row grammar — a monospaced left column and a title with meta on
 * the right — so shipping and publishing read as equal halves of one body of
 * work. That is the whole positioning argument made visible, and it replaces
 * the earlier "portfolio as manuscript" idea, which resolved the dual identity
 * entirely toward Scientist.
 *
 * Light by default, dark on toggle. No section numbering, no bibliography
 * markers: those were the parts that read as academic.
 *
 * All content comes from src/data/content.ts and src/data/publications.json.
 * The previous design is archived at /classic.
 */
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
import {
  publications,
  publicationUrl,
} from '../lib/publications';
import {
  projects,
  PROJECT_GROUPS,
  software,
  SOFTWARE_GROUPS,
  experiences,
  education,
  identity,
  about,
  profiles,
} from '../data/content';

const grouped = PROJECT_GROUPS.map((group) => ({
  group,
  items: projects.filter((p) => p.group === group),
})).filter(({ items }) => items.length > 0);

const softwareGrouped = SOFTWARE_GROUPS.map((group) => ({
  group,
  items: software.filter((pkg) => pkg.group === group),
})).filter(({ items }) => items.length > 0);

const sections = [
  { id: 'about', label: 'About' },
  { id: 'focus', label: 'Focus' },
  { id: 'software', label: 'Software' },
  { id: 'experience', label: 'Experience' },
  { id: 'education', label: 'Education' },
  { id: 'publications', label: 'Publications' },
];
---
<Layout title={`${identity.name} — ${identity.role}`}>
  <Fragment slot="head">
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap"
    />
  </Fragment>

    <header class="topbar">
      <a href="#top" class="wordmark">{identity.name}</a>
      <nav id="site-nav">
          {sections.map((s) => <a href={`#${s.id}`} data-nav-link>{s.label}</a>)}
      </nav>
      <button id="theme-toggle" type="button" aria-label="Switch colour scheme">Dark</button>
    </header>

    <main id="top">
      <!-- Masthead -->
      <section class="masthead">
        <div class="wrap masthead-grid">
          <div>
            <p class="eyebrow">{identity.role}</p>
            <h1>{identity.name}</h1>
            <p class="lede">{identity.tagline}</p>
            <ul class="profiles">
              {profiles.map((p) => (
                <li><a href={p.url} target="_blank" rel="noopener">{p.label}</a></li>
              ))}
            </ul>
          </div>
          <div class="portrait">
            <Image src={photo} alt={identity.name} width={420} format="webp" quality={82} loading="eager" />
          </div>
        </div>
      </section>

      <!-- About -->
      <section id="about" class="sec">
        <div class="wrap">
          <p class="label">About</p>
          <p class="standfirst">{about.standfirst}</p>
          <div class="prose">
            {about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </section>

      <!-- Focus areas -->
      <section id="focus" class="sec">
        <div class="wrap">
          <p class="label">Focus areas</p>
          {grouped.map(({ group, items }) => (
            <div class="group">
              <h2 class="group-title">{group}</h2>
              {items.map((project) => (
                <article class="project">
                  <h3>
                    {project.title}
                    {project.links.map((link) => (
                      <a class="repo" href={link.url} target="_blank" rel="noopener">{link.label} ↗</a>
                    ))}
                  </h3>
                  <p class="project-tagline">{project.tagline}</p>
                  <p class="project-body">{project.description}</p>
                  <p class="tags">{project.tags.join('  ·  ')}</p>
                </article>
              ))}
            </div>
          ))}
        </div>
      </section>

      <!-- Software: same grammar as Publications below -->
      <section id="software" class="sec">
        <div class="wrap">
          <p class="label">Software</p>
          {softwareGrouped.map(({ group, items }) => (
            <div class="group">
              <h2 class="group-title">{group}</h2>
              <ol class="record">
                {items.map((pkg) => (
                  <li>
                    <span class:list={['meta', pkg.role !== 'Contributor' && 'meta-strong']}>
                      {pkg.role === 'Lead developer' ? 'Lead' : pkg.role}
                    </span>
                    <span class="entry">
                      {pkg.url
                        ? <a href={pkg.url} target="_blank" rel="noopener">{pkg.name}</a>
                        : <span class="entry-title">{pkg.name}</span>}
                      <span class="sub">
                        {pkg.note}
                        {pkg.language && <> · {pkg.language}</>}
                        {!pkg.url && <> · Internal</>}
                        {pkg.paper && <> · <a class="repo" href={pkg.paper} target="_blank" rel="noopener">Paper ↗</a></>}
                      </span>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>


      <!-- Background -->
      <section id="experience" class="sec">
        <div class="wrap">
          <p class="label">Experience</p>
          <ol class="record">
            {experiences.map((exp) => (
              <li>
                <span class="meta">{exp.period}</span>
                <span class="entry">
                  <span class="entry-title">{exp.title}</span>
                  <span class="sub">{exp.role}</span>
                  {exp.focus && <span class="sub faint">{exp.focus}</span>}
                  {exp.advisor && <span class="sub faint">Advisor: {exp.advisor}</span>}
                </span>
              </li>
            ))}
          </ol>

        </div>
      </section>

      <section id="education" class="sec">
        <div class="wrap">
          <p class="label">Education</p>
          <ol class="record">
            {education.map((edu) => (
              <li>
                <span class="meta">{edu.period}</span>
                <span class="entry">
                  <span class="entry-title">{edu.school}</span>
                  <span class="sub">{edu.degree}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </section>
      <!-- Publications -->
      <section id="publications" class="sec">
        <div class="wrap">
          <p class="label">Publications</p>
          <ol class="record">
            {publications.map((pub) => (
              <li>
                <span class="meta meta-strong">{pub.year ?? '—'}</span>
                <span class="entry">
                  {publicationUrl(pub)
                    ? <a href={publicationUrl(pub)} target="_blank" rel="noopener">{pub.title}</a>
                    : <span class="entry-title">{pub.title}</span>}
                  <span class="sub">
                    {pub.journal ?? `Preprint · arXiv:${pub.arxivId}`}
                  </span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </section>

    </main>

    <footer>
      <div class="wrap">
        <p class="colophon">© {new Date().getFullYear()} {identity.name}</p>
      </div>
    </footer>

    <script is:inline>
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle');
      const navLinks = [...document.querySelectorAll('[data-nav-link]')];
      const byId = new Map(navLinks.map((a) => [a.getAttribute('href').slice(1), a]));
      const spy = new IntersectionObserver(
        (entries) => {
          entries.filter((e) => e.isIntersecting).forEach((e) => {
            navLinks.forEach((a) => a.classList.remove('is-active'));
            byId.get(e.target.id)?.classList.add('is-active');
          });
        },
        { rootMargin: '-25% 0px -65% 0px' }
      );
      [...byId.keys()].forEach((id) => {
        const el = document.getElementById(id);
        if (el) spy.observe(el);
      });

      button?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        button.textContent = next === 'dark' ? 'Light' : 'Dark';
      });
    </script>
</Layout>

<style is:global>
  :root {
    --bg: #f7f6f3;
    --fg: #16171b;
    --muted: #55585f;
    --faint: #676b72;
    --rule: #e0ddd6;
    --accent: #8a5a12;

    /* Type scale. Three families, three jobs:
       Newsreader — identity and the one-line thesis, nothing else.
       Plex Sans  — every title and every piece of prose.
       Plex Mono  — labels and data, at exactly two sizes.
       Six near-identical mono sizes had accumulated between 0.65 and 0.85rem,
       which reads as drift rather than hierarchy. */
    --t-label: 0.78rem;
    --t-meta: 0.7rem;

    /* One column width for the whole page. Reading measure is controlled by
       narrowing this, not by per-element caps — `ch` resolves against each
       element's own font, so 62ch on a small mono heading came out 130px
       narrower than 62ch on body text, and sections stopped lining up. */
    --measure: 42rem;      /* reading column */
    --rail: 8rem;          /* section label sits here, in what was dead margin */
    --rail-gap: 3rem;
    --composition: 53rem;  /* rail + gap + measure */
    --gutter: clamp(1.25rem, 5vw, 4rem);
  }

  :root[data-theme='dark'] {
    --bg: #0d0e11;
    --fg: #eceae5;
    --muted: #9a9da4;
    --faint: #8b8f97;
    --rule: #24272d;
    --accent: #d9a441;
  }

  *,
  *::before,
  *::after { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-weight: 300;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; }

  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .wrap { max-width: var(--measure); margin-inline: auto; }

  /* The label moves into the left rail rather than stacking above the text,
     so the composition is 53rem wide while lines stay ~74 characters. No
     markup change: the label takes column one, everything else column two. */
  .sec > .wrap {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, var(--measure));
    column-gap: var(--rail-gap);
    justify-content: center;
    max-width: none;
  }

  .sec > .wrap > .label { grid-column: 1; grid-row: 1; margin-bottom: 0; }
  .sec > .wrap > *:not(.label) { grid-column: 2; }

  @media (max-width: 900px) {
    .sec > .wrap {
      display: block;
      max-width: var(--measure);
    }
    .sec > .wrap > .label { margin-bottom: 1.5rem; }
  }

  /* Small brass label that opens every section. */
  .label {
    margin: 0 0 1.5rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ===== Top bar ===== */
  .topbar {
    flex-wrap: wrap;
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.9rem var(--gutter);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .wordmark {
    order: 1;
    margin-right: auto;
    font-family: 'Newsreader', serif;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .topbar nav { order: 2; display: flex; flex-wrap: nowrap; gap: 1.5rem; }

  .topbar nav a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-meta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .topbar nav a:hover { color: var(--fg); }

  .topbar nav a { position: relative; }
  .topbar nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -5px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }
  .topbar nav a.is-active { color: var(--fg); }
  .topbar nav a.is-active::after { transform: scaleX(1); }

  #theme-toggle {
    order: 3;
    flex-shrink: 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-meta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  #theme-toggle:hover { border-color: var(--accent); }

  /* Phones: the name and the theme control share the top line, and the
     section labels drop to their own row and slide sideways. Putting the
     control in with the labels left them fighting over the same width. */
  @media (max-width: 820px) {
    .topbar { row-gap: 0.55rem; padding-bottom: 0.7rem; }
    /* The control keeps the name's line; the labels take the row beneath. */
    #theme-toggle { order: 2; }
    .topbar nav {
      order: 3;
      width: 100%;
      /* One line, always: it slides sideways and never reflows vertically,
         so the header height never changes as the viewport narrows. */
      flex-wrap: nowrap;
      /* Dragging the strip should pan it, not scroll the page. Without this a
         touch with any vertical component scrolls the document instead, so the
         nav feels like it moves up and down. `contain` also stops a horizontal
         overscroll chaining into the browser's back gesture. */
      touch-action: pan-x;
      overscroll-behavior-x: contain;
      gap: 1.15rem;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      /* Fade both edges so a clipped label reads as "there is more" rather
         than as broken text. One-sided, the left edge cut hard once scrolled. */
      mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 92%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 92%, transparent 100%);
    }
    .topbar nav::-webkit-scrollbar { display: none; }
    .topbar nav a { white-space: nowrap; }
  }

  /* ===== Masthead ===== */
  .masthead { padding: clamp(3.5rem, 10vh, 7rem) var(--gutter) clamp(2.5rem, 6vh, 4rem); }

  /* One centred stack at every width. On desktop the portrait used to sit
     off to the right with a wide gap, which read as unbalanced; centred, the
     masthead works as a title block above the left-aligned sections. */
  .masthead-grid {
    max-width: var(--composition);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.4rem;
  }

  .portrait { order: -1; }

  .eyebrow {
    margin: 0 0 1.2rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-meta);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .masthead h1 {
    margin: 0;
    font-family: 'Newsreader', serif;
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 1.1rem 0 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  /* A middot-separated line, matching the tag rows and software meta
     elsewhere on the page. Seven separately underlined items read as a row of
     chips and wrapped into a ragged block on phones. */
  .profiles {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.35rem 1.35rem;
    margin: 1.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* No separators. A dot belongs to the item before it, so whenever the row
     wraps the last one on a line is stranded at the end and the line reads
     off-centre. Spacing alone carries the rhythm at every width. */
  .profiles li { display: flex; }

  .profiles a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-meta);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .profiles a:hover { color: var(--accent); }

  .portrait img {
    display: block;
    width: 9.5rem;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 12%;
    border-radius: 50%;
    filter: grayscale(0.2);
    /* A hairline so the disc has an edge even where the photograph's own
       background is close to the page colour. */
    box-shadow: 0 0 0 1px var(--rule);
  }

  /* In dark mode the photograph's grey studio backdrop sits on a near-black
     page, so the circle loses its edge and the suit merges into it. Lifting
     the image and strengthening the ring separates it again. */
  :root[data-theme='dark'] .portrait img {
    filter: grayscale(0.7) brightness(1.12) contrast(1.06);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--fg) 22%, transparent);
  }

  @media (max-width: 720px) {
    .portrait img { width: 6.5rem; }
    .lede { text-wrap: balance; }
    /* Once the row wraps, the separators are what break the centring: the
       dot belonging to the last item on a line stays behind on that line, so
       it reads wider on one side. Drop them and let spacing do the work —
       every line is then clean text, centred on its own. */
    .profiles { column-gap: 1.1rem; }
  }

  /* ===== Sections ===== */
  .sec {
    padding: clamp(3rem, 8vh, 5rem) var(--gutter);
    border-bottom: 1px solid var(--rule);
  }

  .standfirst {
    margin: 0 0 1.5rem;
    font-family: 'Newsreader', serif;
    font-weight: 400;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    line-height: 1.4;
  }

  .prose p { margin: 0 0 1.1rem; color: var(--muted); }
  .prose p:last-child { margin-bottom: 0; }

  .section-note {
    margin: -0.6rem 0 2rem;
    font-size: 0.85rem;
    color: var(--faint);
  }
  .section-note a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--rule); }
  .section-note a:hover { border-color: var(--accent); }

  /* ===== Focus areas ===== */
  .group { margin-bottom: 3rem; }
  .group:last-child { margin-bottom: 0; }

  .group-title {
    margin: 0 0 1.3rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--rule);
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 500;
    font-size: var(--t-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .project { margin-bottom: 1.8rem; }
  .project:last-child { margin-bottom: 0; }

  .project h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem;
    margin: 0;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    /* Same size as every other named thing on the page — package, paper,
       appointment. Weight alone marks a project as the larger unit; a size
       jump as well made it read as a different system. */
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.005em;
  }

  .repo {
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .repo:hover { border-color: var(--accent); }

  .project-tagline {
    margin: 0.3rem 0 0.6rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-meta);
    letter-spacing: 0.04em;
    color: var(--faint);
  }

  .project-body { margin: 0; color: var(--muted); }

  .tags {
    margin: 0.6rem 0 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-meta);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* ===== The record: one grammar, used by software, papers and background ===== */
  .record { margin: 0; padding: 0; list-style: none; }

  .record li {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--rule);
  }
  .record li:first-child { border-top: 0; }

  .meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-meta);
    letter-spacing: 0.04em;
    color: var(--faint);
    padding-top: 0.28rem;
    font-variant-numeric: tabular-nums;
  }

  .meta-strong { color: var(--accent); }

  .entry { display: flex; flex-direction: column; gap: 0.12rem; min-width: 0; }

  .entry > a,
  .entry-title {
    font-size: 1rem;
    font-weight: 400;
    color: var(--fg);
    text-decoration: none;
    transition: color 0.2s;
  }
  .entry > a { border-bottom: 1px solid transparent; width: fit-content; }
  .entry > a:hover { color: var(--accent); border-color: var(--accent); }

  .sub { font-size: 0.85rem; color: var(--muted); }
  .sub.faint { color: var(--faint); }

  @media (max-width: 620px) {
    .record li { grid-template-columns: 1fr; gap: 0.3rem; }
    .meta { padding-top: 0; }
  }

  /* ===== Footer ===== */
  footer { padding: clamp(2.5rem, 6vh, 4rem) var(--gutter); }
  footer .wrap { max-width: var(--composition); }

  .colophon {
    margin: 0;
    text-align: center;
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--t-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
  }
</style>
