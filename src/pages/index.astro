<style is:global>

/* Layout: full-bleed hero where a diffusion model's sampling run is the artwork (noise resolving
   into a real molecule); below, a two-column editorial body. Committed single dark look; warm and
   cool double as oxygen and nitrogen in the hero and as the page's only accents. */
:root{
  /* Bright palette. The night-sky values, for switching back:
     bg #0d1b33, bg-2 #12233f, ink #f0f4fb, muted #9fb0cc, rule #20335a,
     warm #ff9470, cool #86c8ff, color-scheme dark. */
  /* Minimal and modern: near-monochrome neutrals, two crisp accents used sparingly */
  --bg:#fafaf9;     /* neutral off-white */
  --bg-2:#f3f3f2;
  --ink:#0f172a;    /* slate ink */
  --muted:#64748b;  /* slate grey */
  --rule:#e7e5e4;
  --warm:#4f46e5;   /* indigo: primary accent (links, "AI") and oxygen in the art */
  --cool:#0891b2;   /* cyan: secondary accent ("Quantum") and nitrogen */
  --display:"Geist", "Helvetica Neue", Arial, sans-serif;
  --body:"Figtree", system-ui, -apple-system, sans-serif;
  --mono:"JetBrains Mono", ui-monospace, Menlo, monospace;
  color-scheme:light;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.55}
a{color:inherit}
:focus-visible{outline:2px solid var(--warm);outline-offset:3px;border-radius:2px}
.gutter{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}

/* ---------- hero ---------- */
.hero{position:relative;min-height:0;overflow:hidden;border-bottom:1px solid var(--rule)}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab;touch-action:pan-y}
.hero canvas.drag{cursor:grabbing}
.hero-in{position:relative;max-width:1180px;margin:0 auto;display:flex;flex-direction:column;gap:56px;padding-block:28px 64px;pointer-events:none}
.hero-in > *{pointer-events:auto}
.bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;font-size:14px;color:var(--muted)}
.bar nav{display:flex;gap:18px;flex-wrap:wrap}
.bar a{text-decoration:none}
