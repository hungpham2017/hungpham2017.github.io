---
import Layout from '../layouts/Layout.astro';
/**
 * The sky design. A night sky of twinkling stars, some of them small
 * molecules (neurotransmitters) drawn as star clusters. A shining star travels
 * between four of them in a never-ending loop (serotonin, dopamine,
 * adrenaline, melatonin) and each one it reaches is generated from noise to
 * full structure, then folds back into its cluster.
 *
 * All content comes from src/data/content.ts and src/data/publications.json.
 * The previous designs are archived at /previous and /classic.
 */
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
import { publications, publicationUrl, SCHOLAR_URL, type Publication } from '../lib/publications';
import {
  software, experiences, education, identity, about, links,
  heroLine, scholarStats, workAreas,
} from '../data/content';

const norm = (t: string | null) => (t ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
const pubsFor = (prefixes: string[]) =>
  publications.filter((p) => prefixes.some((pre) => norm(p.title).startsWith(norm(pre))));

// Recent papers: at least five, and always every paper from the latest year.
const latest = Math.max(...publications.map((p) => p.year ?? 0));
const shown = Math.max(5, publications.filter((p) => p.year === latest).length);
const recent = publications.slice(0, shown);
const older = publications.slice(shown);
const venue = (p: Publication) => p.journal ?? (p.arxivId ? `arXiv:${p.arxivId}` : 'Preprint');

const roleLabel = (r: string) => r;

// "March 2022 — Present" -> "2022–now"
const shortPeriod = (period: string) => {
  const years = period.match(/\d{4}/g) ?? [];
  const end = /present/i.test(period) ? 'now' : years[1] ?? '';
  return end ? `${years[0]}–${end}` : years[0] ?? '';
};
const resume = '/assets/resume.pdf';
---
<Layout title={`${identity.name} — AI × Quantum, for chemistry and beyond`}
  description="Hung Q. Pham — research scientist working at AI × quantum chemistry: generative models for chemistry, quantum many-body methods and GPU-accelerated simulation, plus AI products.">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Figtree:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" />
  </Fragment>

<header class="hero">
  <canvas id="cloud" aria-label="A night sky where some stars are small molecules; a shining star travels between them and each one it reaches is generated in full."></canvas>
  <div class="hero-in gutter">
    <div class="bar">
      <span class="mark">hungqpham.com</span>
      <nav><a href="#work">Work</a><a href="#software">Software</a><a href="#papers">Papers</a><a href="#experience">CV</a><a href="#contact">Contact</a></nav>
    </div>
    <div class="title" id="about">
      <div class="headshot"><Image src={photo} alt={identity.name} width={360} format="webp" quality={82} /></div>
      <h1>{identity.name.replace(' Pham', ' Pham')}</h1>
      <p><b>{heroLine.a}</b> × <i>{heroLine.b}</i>{heroLine.rest}</p>
      <div class="hero-about">
        <p class="lead">{about.standfirst}</p>
        <div class="prose">{about.paragraphs.map((p) => <p set:html={p} />)}</div>
      </div>
    </div>
    <div class="spec"><div class="readout" id="readout" hidden></div></div>
  </div>
</header>

<main class="gutter">
  <section class="sec" id="work">
    <h2><small>Work</small>What I work on</h2>
    <div>
      <div class="threads">
        {workAreas.map((w) => {
          const list = pubsFor(w.papers);
          return (
            <article class="thread">
              <span class="k">{w.kind}</span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
              {list.length > 0 && (
                <details class="cp">
                  <summary>Papers ({list.length})</summary>
                  <ul>{list.map((p) => (
                    <li><span class="cy">{p.year}</span><span>
                      {publicationUrl(p) ? <a href={publicationUrl(p)} target="_blank" rel="noopener">{p.title}</a> : <span class="nl">{p.title}</span>}
                      <span class="cv">{venue(p)}</span></span></li>
                  ))}</ul>
                </details>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="sec" id="software">
    <h2><small>Software</small>Things I've built and shipped</h2>
    <ul class="list">
      {software.map((pkg) => (
        <li>
          <span class="n">{(pkg.url ?? pkg.paper) ? <a href={pkg.url ?? pkg.paper} target="_blank" rel="noopener">{pkg.name}</a> : pkg.name}</span>
          <span class="r">{roleLabel(pkg.role)}</span>
          <span class="d">{pkg.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec" id="papers">
    <h2><small>Papers</small>Recent papers</h2>
    <div>
      <ul class="pubs">
        {recent.map((p) => (
          <li><span class="y">{p.year}</span><span>
            {publicationUrl(p) ? <a href={publicationUrl(p)} target="_blank" rel="noopener">{p.title}</a> : <span class="nl">{p.title}</span>}
            <span class="j">{venue(p)}</span></span></li>
        ))}
      </ul>
      <details class="all">
        <summary><span class="o">Show {older.length} more ({publications.length} in total)</span><span class="c">Show fewer</span></summary>
        <ul class="pubs">
          {older.map((p) => (
            <li><span class="y">{p.year}</span><span>
              {publicationUrl(p) ? <a href={publicationUrl(p)} target="_blank" rel="noopener">{p.title}</a> : <span class="nl">{p.title}</span>}
              <span class="j">{venue(p)}</span></span></li>
          ))}
        </ul>
      </details>
      <a class="more" href={SCHOLAR_URL} target="_blank" rel="noopener">Google Scholar</a>
    </div>
  </section>

  <section class="sec" id="experience">
    <h2><small>Experience</small>Academia and industry</h2>
    <div class="path">
      {experiences.map((e) => (
        <div><span class="t">{shortPeriod(e.period)}</span><span><b>{e.title}</b>
          <span>{e.role}{e.advisor && ` with ${e.advisor}`}</span>
          {e.focus && <span class="f">{e.focus}</span>}</span></div>
      ))}
    </div>
  </section>

  <section class="sec" id="education">
    <h2><small>Education</small>Academic background</h2>
    <div class="path">
      {education.map((e) => (
        <div><span class="t">{shortPeriod(e.period)}</span><span><b>{e.degree}</b><span>{e.school}</span></span></div>
      ))}
      <a class="more" href={resume} target="_blank" rel="noopener">Full CV (PDF)</a>
    </div>
  </section>

  <section class="contact" id="contact">
    <h2>Working on something useful?</h2>
    <p class="cta-sub">I'd like to bring an AI + Science mindset to it.</p>
    <div class="addr">{links.email.replace('mailto:', '')}</div>
    <div class="links">
      <a href={links.github} target="_blank" rel="noopener">GitHub</a>
      <a href={links.scholar} target="_blank" rel="noopener">Google Scholar</a>
      <a href={links.orcid} target="_blank" rel="noopener">ORCID</a>
      <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={links.twitter} target="_blank" rel="noopener">X / Twitter</a>
      <a href={resume} target="_blank" rel="noopener">CV (PDF)</a>
    </div>
    <p class="colophon">© {new Date().getFullYear()} {identity.name}</p>
  </section>
</main>

<script is:inline>

(function(){
  var css = getComputedStyle(document.documentElement);
  function tok(n){ return css.getPropertyValue(n).trim(); }
  var BG = tok("--bg"), INK = tok("--ink"), MUTED = tok("--muted"), WARM = tok("--warm"), COOL = tok("--cool");
  var EL = { C: INK, N: COOL, O: WARM };
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var ro = document.getElementById("readout"); if(ro) ro.hidden = true;
  function rng(seed){ return function(){ seed|=0; seed=seed+0x6D2B79F5|0; var t=Math.imul(seed^seed>>>15,1|seed); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }
  function gauss(r){ var u=1-r(), v=r(); return Math.sqrt(-2*Math.log(u))*Math.cos(6.2832*v); }
  function ease(a){ return a<.5 ? 4*a*a*a : 1-Math.pow(-2*a+2,3)/2; }

  /* Real molecules, heavy atoms only, unit bond length: [element, x, y] and [i, j, order]. */
  var MOLS = [
    { atoms:[["C",0,1],["C",.866,.5],["C",.866,-.5],["C",0,-1],["C",-.866,-.5],["C",-.866,.5],["C",1.817,.809],["C",2.405,0],["N",1.817,-.809],["O",-1.732,1],["C",2.126,1.76],["C",3.104,1.968],["N",3.413,2.919]],
      bonds:[[5,0,2],[0,1,1],[1,2,2],[2,3,1],[3,4,2],[4,5,1],[1,6,1],[6,7,2],[7,8,1],[8,2,1],[5,9,1],[6,10,1],[10,11,1],[11,12,1]] },                         // serotonin
    { atoms:[["C",0,1],["C",.866,.5],["C",.866,-.5],["C",0,-1],["C",-.866,-.5],["C",-.866,.5],["C",1.732,1],["C",2.598,.5],["N",3.464,1],["O",-1.732,1],["O",-1.732,-1]],
      bonds:[[0,1,2],[1,2,1],[2,3,2],[3,4,1],[4,5,2],[5,0,1],[1,6,1],[6,7,1],[7,8,1],[5,9,1],[4,10,1]] },                                                     // dopamine
    { atoms:[["C",0,1],["C",.866,.5],["C",.866,-.5],["C",0,-1],["C",-.866,-.5],["C",-.866,.5],["C",1.817,.809],["C",2.405,0],["N",1.817,-.809],["O",-1.732,1],["C",2.126,1.76],["C",3.104,1.968],["N",3.413,2.919],["C",-2.598,1.5],["C",4.391,3.127],["O",4.7,4.078],["C",5.06,2.384]],
      bonds:[[5,0,2],[0,1,1],[1,2,2],[2,3,1],[3,4,2],[4,5,1],[1,6,1],[6,7,2],[7,8,1],[8,2,1],[5,9,1],[6,10,1],[10,11,1],[11,12,1],[9,13,1],[12,14,1],[14,15,2],[14,16,1]] },   // melatonin
    { atoms:[["C",0,1],["C",.866,.5],["C",.866,-.5],["C",0,-1],["C",-.866,-.5],["C",-.866,.5],["C",1.732,1],["C",2.598,.5],["N",3.464,1],["O",-1.732,1],["O",-1.732,-1],["O",1.732,2]],
      bonds:[[0,1,2],[1,2,1],[2,3,2],[3,4,1],[4,5,2],[5,0,1],[1,6,1],[6,7,1],[7,8,1],[5,9,1],[4,10,1],[6,11,1]] },                                            // norepinephrine
    { atoms:[["C",0,1],["C",.866,.5],["C",.866,-.5],["C",0,-1],["C",-.866,-.5],["C",-.866,.5],["C",1.732,1],["C",2.598,.5],["N",3.464,1],["O",-1.732,1],["O",-1.732,-1],["O",1.732,2],["C",4.33,.5]],
      bonds:[[0,1,2],[1,2,1],[2,3,2],[3,4,1],[4,5,2],[5,0,1],[1,6,1],[6,7,1],[7,8,1],[5,9,1],[4,10,1],[6,11,1],[8,12,1]] },                                   // epinephrine
    { atoms:[["N",0,0],["C",.866,.5],["C",1.732,0],["C",2.598,.5],["C",3.464,0],["O",3.464,-1],["O",4.33,.5]],
      bonds:[[0,1,1],[1,2,1],[2,3,1],[3,4,1],[4,5,2],[4,6,1]] },                                                                                             // GABA
    { atoms:[["C",0,0],["O",-.866,.5],["O",0,-1],["C",.866,.5],["N",.866,1.5],["C",1.732,0],["C",2.598,.5],["C",3.464,0],["O",3.464,-1],["O",4.33,.5]],
      bonds:[[0,1,2],[0,2,1],[0,3,1],[3,4,1],[3,5,1],[5,6,1],[6,7,1],[7,8,2],[7,9,1]] },                                                                      // glutamate
    { atoms:[["C",0,0],["C",.866,.5],["O",.866,1.5],["O",1.732,0],["C",2.598,.5],["C",3.464,0],["N",4.33,.5],["C",3.83,1.366],["C",5.196,1],["C",4.83,-.366]],
      bonds:[[0,1,1],[1,2,2],[1,3,1],[3,4,1],[4,5,1],[5,6,1],[6,7,1],[6,8,1],[6,9,1]] },                                                                      // acetylcholine
    { atoms:[["C",.809,.263],["C",0,.851],["N",-.809,.263],["C",-.5,-.688],["N",.5,-.688],["C",1.76,.572],["C",2.503,-.097],["N",3.454,.212]],
      bonds:[[0,1,2],[1,2,1],[2,3,1],[3,4,2],[4,0,1],[0,5,1],[5,6,1],[6,7,1]] },                                                                              // histamine
    { atoms:[["N",0,0],["C",.866,.5],["C",1.732,0],["O",1.732,-1],["O",2.598,.5]],
      bonds:[[0,1,1],[1,2,1],[2,3,2],[2,4,1]] }                                                                                                               // glycine
  ];
  MOLS.forEach(function(m){ var sx=0,sy=0,n=m.atoms.length; m.atoms.forEach(function(a){sx+=a[1];sy+=a[2];}); sx/=n; sy/=n; m.P=m.atoms.map(function(a){ return [a[1]-sx, -(a[2]-sy)]; }); });

  var cv = document.getElementById("cloud"), ctx = cv.getContext("2d");
  var NOW = 0, tail = [], NAVBAND = 80, W=0, H=0, wide=true, stars=[], dust=[], glyphs=[], stage=[], roundStart=0, gl=4, bl=40;

  function build(){
    var r = rng(9);
    var skyH = wide ? H : H*0.66;
    stars = []; dust = [];
    for(var i=0;i<(wide?440:200);i++) stars.push({x:r()*W, y:r()*skyH, s:0.6+Math.pow(r(),3)*1.7, a:0.3+r()*0.5, w:0.0003+r()*0.0011, p:r()*6.28, litT:0});
    // a faint band of distant dust, like the Milky Way
    for(i=0;i<(wide?900:420);i++){ var t=r(), off=gauss(r)*(wide?0.07:0.06);
      var x = wide ? W*(0.25+0.8*t) : W*t, y = wide ? H*(0.95-0.85*t+off) : skyH*(0.85-0.6*t+off*1.4);
      dust.push([x, y, 0.5+r()*0.6, 0.05+r()*0.1]); }
    gl = wide ? 12 : 8.5;
    NAVBAND = wide ? 80 : 125;
    bl = wide ? Math.min(H*0.052, W*0.029) : W*0.046;
    // the tour: serotonin -> dopamine -> adrenaline -> melatonin, each at a spot where its full structure fits
    // spread across the whole sky, each in open space clear of the name, headline and menu
    var S = wide ? [[0.66,0.45],[0.3,0.2],[0.32,0.84],[0.85,0.72]] : [[0.5,0.37],[0.3,0.26],[0.7,0.52],[0.38,0.56]];
    var O = wide ? [[0.08,0.14],[0.47,0.1],[0.96,0.1],[0.53,0.9],[0.48,0.36],[0.97,0.45]]
                 : [[0.1,0.42],[0.9,0.42],[0.1,0.62],[0.9,0.62],[0.88,0.24],[0.62,0.66]];
    var MI = [0,1,4,2, 3,5,6,7,8,9];
    glyphs = S.concat(O).map(function(p,k){ return {x:p[0]*W, y:p[1]*H, w:0.0005+0.0006*((k*37)%10)/10, p:k*1.7, mi:MI[k]}; });
  }
  // serotonin is the one focal point; every other molecule is a small shining star

  function resize(){
    var dpr = Math.min(window.devicePixelRatio||1, 2);
    W = cv.clientWidth; H = cv.clientHeight; wide = W > 820;
    cv.width = W*dpr; cv.height = H*dpr; ctx.setTransform(dpr,0,0,dpr,0,0);
    roundStart = 0; firstTrip = true; build(); cyc = -1; edges = []; newCycle(performance.now());
    if(reduce) still();
  }

  /* ---- one discovery: explore (draw constellations) -> bloom -> hold -> fold back ---- */
  var TOUR = 4, FADE_MS = 30000, GEN = 3000, HOLD = 4500, FOLD = 700, RESET = 2600, travelT = 3000, genT = 3000, pathPts = [], pathLen = [], firstTrip = true;
  var cyc = -1, route = [], site = null, target = null, eps = [], trails = [], phase = "explore", t0 = 0, ringT = -1, edges = [], lastLit = -1, lastNow = 0;
  function newCycle(now){
    var prev = cyc; cyc = (cyc + 1) % TOUR;
    target = glyphs[cyc]; site = [target.x, target.y];
    var side = Math.random() < 0.5 ? -1 : 1, start = prev < 0 ? [site[0] + side*(wide ? W*0.16 : W*0.32), site[1] + (Math.random()-0.5)*(wide ? H*0.25 : H*0.12)] : [glyphs[prev].x, glyphs[prev].y];   // the first star drifts in from nearby
    route = [start];
    var pool = stars.filter(function(s){ return (wide ? s.x > W*0.45 : true) && s.y > (wide?H*0.12:H*0.2) && s.y < (wide?H*0.9:H*0.62); });
    var first = firstTrip; firstTrip = false;
    // straight on to the next molecule along one gentle curve
    var mx = (start[0]+site[0])/2, my = (start[1]+site[1])/2, dx = site[0]-start[0], dy = site[1]-start[1], bend = (Math.random() < 0.5 ? 1 : -1)*0.18;
    route.push([mx - dy*bend, my + dx*bend]);
    route.push(site.slice());
    // one smooth curve through the waypoints (Catmull-Rom), travelled at a steady speed
    pathPts = []; pathLen = [0];
    for(var sg=0; sg<route.length-1; sg++){ var p0 = route[Math.max(0,sg-1)], p1 = route[sg], p2 = route[sg+1], p3 = route[Math.min(route.length-1, sg+2)];
      for(var q=0; q<24; q++){ var t = q/24, t2 = t*t, t3 = t2*t;
        pathPts.push([0.5*((2*p1[0]) + (-p0[0]+p2[0])*t + (2*p0[0]-5*p1[0]+4*p2[0]-p3[0])*t2 + (-p0[0]+3*p1[0]-3*p2[0]+p3[0])*t3),
                      0.5*((2*p1[1]) + (-p0[1]+p2[1])*t + (2*p0[1]-5*p1[1]+4*p2[1]-p3[1])*t2 + (-p0[1]+3*p1[1]-3*p2[1]+p3[1])*t3)]); } }
    pathPts.push(site.slice());
    for(var pi=1; pi<pathPts.length; pi++) pathLen.push(pathLen[pi-1] + Math.hypot(pathPts[pi][0]-pathPts[pi-1][0], pathPts[pi][1]-pathPts[pi-1][1]));
    var speed = wide ? 0.19 : 0.12;   // px per ms
    travelT = first ? 1800 : 2400;   // about 2.4 s from one molecule to the next
    genT = first ? 1700 : 2400;   // the first serotonin is fully formed about 3 s after the page opens
    var m = MOLS[target.mi];
    eps = m.P.map(function(p){ var q=[p[0]*gl/bl + gauss(Math.random)*1.3, p[1]*gl/bl + gauss(Math.random)*1.3], path=[];
      for(var k=0;k<40;k++){ path.push(q.slice()); q[0]+=gauss(Math.random)*0.11; q[1]+=gauss(Math.random)*0.11; }
      return path.reverse(); });
    trails = m.P.map(function(){ return []; });
    phase = "explore"; t0 = now; ringT = -1;
  }
  function sched(u){ return (1-Math.cos(Math.PI*u))/2; }
  function atomPos(j, u){ var m = MOLS[target.mi], a = sched(u), s = Math.sqrt(Math.max(0,1-a*a)), f=(1-u)*39, k=Math.floor(f), r=f-k, e0=eps[j][k], e1=eps[j][Math.min(39,k+1)], p=m.P[j];
    return [site[0] + (a*p[0] + s*(e0[0]+(e1[0]-e0[0])*r))*bl, site[1] + (a*p[1] + s*(e0[1]+(e1[1]-e0[1])*r))*bl]; }
  function explorerAt(el){
    // glide: gentle start, steady cruise, settles as it arrives
    var x = Math.min(1, el/travelT), q = x < 0.15 ? 0.5*(x/0.15)*(x/0.15)*0.15 : x > 0.75 ? 1 - 0.5*Math.pow((1-x)/0.25, 2)*0.25 : 0.075 + (x-0.15)*(1-0.075-0.125)/0.6;
    var L = q*pathLen[pathLen.length-1], i = 1; while(i < pathLen.length-1 && pathLen[i] < L) i++;
    var f = (L - pathLen[i-1]) / Math.max(1e-6, pathLen[i]-pathLen[i-1]);
    return [pathPts[i-1][0] + (pathPts[i][0]-pathPts[i-1][0])*f, pathPts[i-1][1] + (pathPts[i][1]-pathPts[i-1][1])*f];
  }

  function drawMol(m, cx, cy, scale, alpha, colour){
    var S = m.P.map(function(p){ return [cx+p[0]*scale, cy+p[1]*scale]; });
    ctx.strokeStyle = INK; ctx.lineWidth = Math.max(0.7, scale*0.06); ctx.globalAlpha = alpha*0.85;
    m.bonds.forEach(function(b){ var p=S[b[0]], q=S[b[1]];
      if(b[2]===2 && scale > 8){ var dx=q[0]-p[0], dy=q[1]-p[1], L=Math.hypot(dx,dy)||1, o=scale*0.07, nx=-dy/L*o, ny=dx/L*o; ctx.beginPath(); ctx.moveTo(p[0]+nx,p[1]+ny); ctx.lineTo(q[0]+nx,q[1]+ny); ctx.moveTo(p[0]-nx,p[1]-ny); ctx.lineTo(q[0]-nx,q[1]-ny); ctx.stroke(); }
      else { ctx.beginPath(); ctx.moveTo(p[0],p[1]); ctx.lineTo(q[0],q[1]); ctx.stroke(); } });
    S.forEach(function(s,j){ var e = m.atoms[j][0]; if(e==="C" && scale <= 8) return;
      var rr = scale > 8 ? (e==="C"?0.17:0.22)*scale : 1.1;
      if(scale > 8){ ctx.globalAlpha = alpha; ctx.fillStyle = BG; ctx.beginPath(); ctx.arc(s[0],s[1],rr+2.5,0,6.283); ctx.fill(); }
      ctx.globalAlpha = alpha*(scale>8?1:0.9); ctx.fillStyle = colour ? EL[e] : INK; ctx.beginPath(); ctx.arc(s[0],s[1],rr,0,6.283); ctx.fill(); });
  }

  // a molecule drawn as a small cluster of stars: each atom a twinkling point, bonds as faint constellation lines
  function drawStarMol(m, cx, cy, scale, alpha, seed, now){
    var S = m.P.map(function(p){ return [cx+p[0]*scale, cy+p[1]*scale]; });
    ctx.strokeStyle = INK; ctx.lineWidth = 0.6; ctx.globalAlpha = alpha*0.22; ctx.beginPath();
